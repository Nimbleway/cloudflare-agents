{
  "name": "@nimble-way/cloudflare-agents",
  "version": "0.1.0",
  "description": "Resumable Nimble Agent API V2 tools for Cloudflare Agents",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nimbleway/cloudflare-agents.git"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external agents --external @nimble-way/nimble-js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@nimble-way/nimble-js": "1.2.0"
  },
  "peerDependencies": {
    "agents": ">=0.20.0 <1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "agents": "0.20.0",
    "eslint": "^9.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": ">=20"
  }
}
